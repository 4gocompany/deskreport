{
  "name": "deskreport-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "DeskReport Desktop Companion: widget nativo na bandeja do sistema",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.deskreport.desktop",
    "productName": "DeskReport",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/tray-*.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "DeskReport"
        }
      },
      "artifactName": "DeskReport-linux.AppImage"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DeskReport-windows.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "DeskReport-macos.dmg"
    }
  },
  "desktopName": "deskreport.desktop"
}
